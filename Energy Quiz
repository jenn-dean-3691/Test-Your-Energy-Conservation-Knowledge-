<style>
  #pq-root {
    --bg: #FFFFFF;
    --panel: #FBFCFA;
    --panel-edge: #E3E7E2;
    --track: #ECEFEA;
    --ink: #151742;
    --muted: #707A8C;
    --accent: #1FA971;
    --accent-dim: #0F7A50;
    --accent-tint: #E6F5EE;
    --warn: #D64545;
    --warn-tint: #FBEAEA;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: var(--ink);
    background: var(--bg);
    max-width: 640px;
    margin: 0 auto;
    padding: 0;
    border-radius: 14px;
    border: 1px solid var(--panel-edge);
    box-shadow: 0 1px 2px rgba(21,23,66,0.04), 0 20px 48px rgba(21,23,66,0.08);
    position: relative;
    overflow: hidden;
  }
  #pq-root::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--accent-dim), var(--accent), #5ED14F);
  }
  .pq-inner { padding: 44px 40px; min-height: 420px; }
  .pq-eyebrow {
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-dim);
    margin: 0 0 10px 0;
  }
  .pq-title {
    font-size: 27px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 12px 0;
    line-height: 1.2;
    color: var(--ink);
  }
  .pq-sub {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.6;
    margin: 0 0 30px 0;
  }
  .pq-btn {
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--accent);
    color: #FFFFFF;
    font-weight: 700;
    border: none;
    padding: 13px 28px;
    cursor: pointer;
    border-radius: 6px;
    transition: transform 0.12s ease, background 0.12s ease, box-shadow 0.12s ease;
  }
  .pq-btn:hover { background: var(--accent-dim); box-shadow: 0 6px 16px rgba(31,169,113,0.28); }
  .pq-btn:active { transform: scale(0.97); }
  .pq-btn:disabled { background: var(--track); color: var(--muted); cursor: not-allowed; box-shadow: none; }
  .pq-btn-ghost {
    background: transparent;
    color: var(--muted);
    border: 1px solid var(--panel-edge);
  }
  .pq-btn-ghost:hover { background: transparent; color: var(--accent-dim); border-color: var(--accent); box-shadow: none; }

  .pq-qnum {
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .pq-progress {
    display: flex;
    gap: 5px;
    margin-bottom: 26px;
  }
  .pq-progress-seg {
    height: 6px;
    flex: 1;
    background: var(--track);
    border-radius: 3px;
  }
  .pq-progress-seg.done { background: var(--accent); }

  .pq-question {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.45;
    margin: 0 0 26px 0;
    color: var(--ink);
  }
  .pq-choices { display: flex; flex-direction: column; gap: 10px; margin-bottom: 8px; }
  .pq-choice {
    display: flex;
    align-items: center;
    gap: 12px;
    text-align: left;
    font-family: inherit;
    font-size: 15px;
    padding: 14px 16px;
    background: var(--panel);
    border: 1px solid var(--panel-edge);
    border-left: 3px solid var(--panel-edge);
    border-radius: 6px;
    cursor: pointer;
    color: var(--ink);
    transition: border-color 0.12s ease, background 0.12s ease;
  }
  .pq-choice:hover { border-color: var(--accent); border-left-color: var(--accent); }
  .pq-choice.selected { border-left-color: var(--accent); background: var(--accent-tint); border-color: var(--accent); }
  .pq-choice .pq-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--panel-edge);
    flex-shrink: 0;
    transition: background 0.12s ease;
  }
  .pq-choice.selected .pq-dot { background: var(--accent); }

  .pq-nav { display: flex; justify-content: space-between; align-items: center; margin-top: 28px; }

  .pq-center { text-align: center; }
  .pq-loading { color: var(--muted); font-family: 'JetBrains Mono', monospace; font-size: 13px; }

  .pq-readout {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-weight: 700;
    color: var(--accent-dim);
    background: var(--accent-tint);
    border: 1px solid var(--accent);
    border-radius: 6px;
    padding: 10px 20px;
    font-size: 26px;
    letter-spacing: 0.02em;
    margin-bottom: 26px;
  }
  .pq-readout span { font-size: 13px; color: var(--muted); font-weight: 500; }

  .pq-percentile-line {
    font-size: 17px;
    color: var(--muted);
    line-height: 1.5;
    margin: 0 0 4px 0;
  }
  .pq-percentile-line strong {
    color: var(--accent-dim);
    font-size: 30px;
    font-family: 'JetBrains Mono', monospace;
  }
  .pq-count {
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 26px;
  }

  .pq-gauge-wrap { margin: 6px 0 28px 0; }
  .pq-gauge-value {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    fill: var(--accent-dim);
  }
  .pq-gauge-tick { fill: var(--muted); font-family: 'JetBrains Mono', monospace; }

  .pq-reset {
    margin-top: 18px;
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 11px;
    color: var(--muted);
    background: none;
    border: none;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
  }

  .pq-review {
    text-align: left;
    margin-top: 36px;
    padding-top: 28px;
    border-top: 1px solid var(--panel-edge);
  }
  .pq-review-title {
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 16px 0;
  }
  .pq-review-item {
    padding: 16px;
    margin-bottom: 10px;
    background: var(--panel);
    border: 1px solid var(--panel-edge);
    border-left: 3px solid var(--panel-edge);
    border-radius: 6px;
  }
  .pq-review-item.is-correct { border-left-color: var(--accent); background: var(--accent-tint); }
  .pq-review-item.is-wrong { border-left-color: var(--warn); background: var(--warn-tint); }
  .pq-review-q {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 10px;
    color: var(--ink);
  }
  .pq-review-mark {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 13px;
    flex-shrink: 0;
  }
  .pq-review-mark.correct { color: var(--accent-dim); }
  .pq-review-mark.wrong { color: var(--warn); }
  .pq-review-choices { padding-left: 21px; }
  .pq-review-choice {
    font-size: 14px;
    line-height: 1.8;
    color: var(--muted);
  }
  .pq-review-choice.is-correct { color: var(--accent-dim); font-weight: 700; }
  .pq-review-choice.is-user-wrong { color: var(--warn); text-decoration: line-through; }
  .pq-review-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.04em;
    margin-left: 6px;
  }

  .pq-admin-row {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px dashed var(--panel-edge);
    text-align: left;
  }
  .pq-admin-badge {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-dim);
    background: var(--accent-tint);
    border: 1px solid var(--accent);
    border-radius: 4px;
    padding: 3px 8px;
    margin-bottom: 14px;
  }
  .pq-admin-stats {
    display: flex;
    gap: 10px;
    margin-bottom: 18px;
  }
  .pq-admin-stat {
    flex: 1;
    background: var(--panel);
    border: 1px solid var(--panel-edge);
    border-radius: 6px;
    padding: 12px;
    text-align: center;
  }
  .pq-admin-stat-value {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 20px;
    color: var(--ink);
  }
  .pq-admin-stat-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: var(--muted);
    margin-top: 2px;
  }
  .pq-admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    margin-bottom: 16px;
  }
  .pq-admin-table th {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    text-align: left;
    padding: 6px 8px;
    border-bottom: 1px solid var(--panel-edge);
  }
  .pq-admin-table td {
    padding: 7px 8px;
    border-bottom: 1px solid var(--panel-edge);
    font-family: 'JetBrains Mono', monospace;
    color: var(--ink);
  }
  .pq-admin-status {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--muted);
    margin-top: 8px;
  }
</style>

<div id="pq-root"><div class="pq-inner" id="pq-inner">
  <p class="pq-loading">loading…</p>
</div></div>

<script>
(function(){

  // ============================================================
  // EDIT YOUR QUIZ HERE — swap the title and questions below.
  // Each question needs: text, choices (array), correctIndex.
  // ============================================================
  const QUIZ_TITLE = "Test Your Knowledge on Energy Conservation!";
  const QUIZ_INTRO = "11 quick questions. When you finish, you'll see your score and exactly what percentage of other participants you beat.";
  // NOTE: correctIndex values below were inferred from standard energy-
  // conservation facts, since Quiz Maker's public embed doesn't expose
  // which answer was marked correct in your original quiz. Please verify
  // each one against your source quiz and adjust the index if needed
  // (0 = first choice, 1 = second choice, etc).
  const QUESTIONS = [
    { text: "Which of the following best defines \"energy conservation\"?",
      choices: ["Converting energy from one form to another", "Reducing energy consumption by using less of a service", "Storing energy for later use", "Generating energy from renewable sources"], correctIndex: 1 },
    { text: "Which of the following is NOT an example of a renewable energy source?",
      choices: ["Hydroelectric", "Wind", "Solar", "Natural Gas"], correctIndex: 3 },
    { text: "Which of the following best defines \"energy efficiency\"?",
      choices: ["Reducing energy use by consuming less of a service", "Using renewable energy instead of fossil fuels", "Accomplishing the same task while using less energy", "Storing surplus energy for later use"], correctIndex: 2 },
    { text: "Which of the following typically uses the most electricity in a commercial building?",
      choices: ["Lighting", "HVAC Systems", "Elevators", "Computers"], correctIndex: 1 },
    { text: "Which of the following behaviors can help reduce overall energy consumption on a college campus?",
      choices: ["Using natural light whenever possible", "Opening windows when it's too hot/cold", "Printing on both sides of the paper", "Keeping lights on when you leave a room"], correctIndex: 0 },
    { text: "In the widely used \"Reduce, Reuse, Recycle\" waste hierarchy, which action is generally considered the MOST effective for sustainability?",
      choices: ["Reduce", "Reuse", "Recycle", "All are equally effective"], correctIndex: 0 },
    { text: "Which sector typically consumes the most energy in the United States?",
      choices: ["Residential (houses/apartments)", "Commercial (universities/offices)", "Transportation (cars/buses/planes)", "Agriculture (farming/livestock)"], correctIndex: 2 },
    { text: "A programmable or \"smart\" thermostat helps conserve energy primarily by:",
      choices: ["Automatically adjusting heating/cooling based on occupancy and schedule", "Running the HVAC system continuously at a fixed temperature all day", "Producing its own electricity", "Storing energy for future use"], correctIndex: 0 },
    { text: "Which of the following best defines an \"energy audit\"?",
      choices: ["A government inspection of a building's energy bills", "A systematic assessment of a building's energy use to identify opportunities for conservation", "A fine issued for exceeding an electricity usage limit", "A measurement of a building's total energy usage per square foot"], correctIndex: 1 },
    { text: "Which of these habits wastes the MOST energy for a typical college student?",
      choices: ["Charging electronics overnight", "Using gaming systems", "Leaving the TV on when you aren't home", "Using a laptop to take notes in class"], correctIndex: 2 },
    { text: "Why does energy conservation matter to me?",
      choices: ["It keeps my utility bills lower and reduces your environmental impact", "It helps protect my future quality of life", "It reduces strain on the electric grid and helps prevent power outages", "All of the above"], correctIndex: 3 }
  ];
  // ============================================================
  // GOOGLE SHEETS BACKEND: paste the web app URL you get after
  // deploying AppsScript_Code.gs here (it ends in /exec). Leave
  // blank and the quiz will still work but scores won't be saved.
  const GOOGLE_SHEETS_URL = "https://script.google.com/macros/s/AKfycbwyNUoK3svIuGXWKvAepegJUblbZamD6qWI4LZv4XSl0p2n4-uJrMOMDbDhScg0Lw/exec";
  // ============================================================
  // ADMIN ACCESS: change this to your own secret word. To view the
  // results dashboard, open this quiz with ?admin=YOUR_SECRET added
  // to the end of the URL. Nobody without that exact link sees any
  // admin controls — the dashboard doesn't render in the page at all
  // for regular participants. Note: this is a convenience gate, not
  // real authentication — treat the admin link like a password.
  const ADMIN_KEY = "cenergistic-admin-2026";
  const isAdmin = (new URLSearchParams(window.location.search)).get('admin') === ADMIN_KEY;
  // ============================================================

  const root = document.getElementById('pq-inner');
  let state = { screen: 'intro', qIndex: 0, answers: new Array(QUESTIONS.length).fill(null), percentileData: null, error: null };

  function render() {
    if (state.screen === 'intro') return renderIntro();
    if (state.screen === 'question') return renderQuestion();
    if (state.screen === 'submitting') return renderSubmitting();
    if (state.screen === 'results') return renderResults();
  }

  function renderIntro() {
    root.innerHTML = `
      <p class="pq-eyebrow">Quiz · ${QUESTIONS.length} questions</p>
      <h1 class="pq-title">${escapeHtml(QUIZ_TITLE)}</h1>
      <p class="pq-sub">${escapeHtml(QUIZ_INTRO)}</p>
      <button class="pq-btn" id="pq-start">Begin</button>
      ${isAdmin ? `<div class="pq-admin-row" id="pq-admin-row"><span class="pq-admin-badge">Admin view</span><p class="pq-admin-status" id="pq-admin-loading">loading results…</p></div>` : ''}
    `;
    document.getElementById('pq-start').onclick = () => { state.screen = 'question'; state.qIndex = 0; render(); };
    if (isAdmin) loadAdminDashboard();
  }

  async function fetchAttempts() {
    if (!GOOGLE_SHEETS_URL) throw new Error("GOOGLE_SHEETS_URL not configured");
    const res = await fetch(`${GOOGLE_SHEETS_URL}?action=list`);
    const data = await res.json();
    if (data.error) throw new Error(data.error);
    return data.attempts || [];
  }

  async function loadAdminDashboard() {
    const rowEl = document.getElementById('pq-admin-row');
    if (!rowEl) return;
    try {
      let attempts = await fetchAttempts();
      attempts.sort((a, b) => new Date(b.ts) - new Date(a.ts));

      const count = attempts.length;
      const avg = count ? (attempts.reduce((s, a) => s + a.score, 0) / count) : 0;
      const high = count ? Math.max(...attempts.map(a => a.score)) : 0;

      const rows = attempts.slice(0, 50).map(a => {
        const when = a.ts ? new Date(a.ts).toLocaleString() : '—';
        return `<tr><td>${a.score}/${a.total}</td><td>${when}</td></tr>`;
      }).join('');

      rowEl.innerHTML = `
        <span class="pq-admin-badge">Admin view</span>
        <div class="pq-admin-stats">
          <div class="pq-admin-stat"><div class="pq-admin-stat-value">${count}</div><div class="pq-admin-stat-label">attempts</div></div>
          <div class="pq-admin-stat"><div class="pq-admin-stat-value">${avg.toFixed(1)}</div><div class="pq-admin-stat-label">avg score</div></div>
          <div class="pq-admin-stat"><div class="pq-admin-stat-value">${high}/${QUESTIONS.length}</div><div class="pq-admin-stat-label">top score</div></div>
        </div>
        ${count ? `<table class="pq-admin-table"><thead><tr><th>Score</th><th>Completed</th></tr></thead><tbody>${rows}</tbody></table>${count > 50 ? `<p class="pq-admin-status">showing most recent 50 of ${count}</p>` : ''}` : `<p class="pq-admin-status">no attempts recorded yet.</p>`}
        <button class="pq-reset" id="pq-reset-attempts">Reset all stored attempts</button>
        <p class="pq-admin-status" id="pq-reset-status"></p>
      `;
      const resetBtn = document.getElementById('pq-reset-attempts');
      if (resetBtn) resetBtn.onclick = resetAllAttempts;
    } catch (e) {
      rowEl.innerHTML = `<span class="pq-admin-badge">Admin view</span><p class="pq-admin-status">couldn't load results — check GOOGLE_SHEETS_URL is set and deployed.</p>`;
    }
  }

  async function resetAllAttempts() {
    const statusEl = document.getElementById('pq-reset-status');
    if (!window.confirm('This will permanently delete every stored attempt for this quiz, for all participants. Continue?')) return;
    if (statusEl) statusEl.textContent = 'clearing…';
    try {
      const res = await fetch(`${GOOGLE_SHEETS_URL}?action=reset&key=${encodeURIComponent(ADMIN_KEY)}`);
      const data = await res.json();
      if (data.error) throw new Error(data.error);
      if (statusEl) statusEl.textContent = 'all attempts cleared.';
      loadAdminDashboard();
    } catch (e) {
      if (statusEl) statusEl.textContent = "couldn't reach the Sheets backend — try again.";
    }
  }

  function renderQuestion() {
    const q = QUESTIONS[state.qIndex];
    const selected = state.answers[state.qIndex];
    const segs = QUESTIONS.map((_, i) => `<div class="pq-progress-seg ${i <= state.qIndex ? 'done' : ''}"></div>`).join('');
    root.innerHTML = `
      <div class="pq-progress">${segs}</div>
      <p class="pq-qnum">Question ${state.qIndex + 1} of ${QUESTIONS.length}</p>
      <h2 class="pq-question">${escapeHtml(q.text)}</h2>
      <div class="pq-choices">
        ${q.choices.map((c, i) => `<button class="pq-choice ${selected === i ? 'selected' : ''}" data-i="${i}"><span class="pq-dot"></span>${escapeHtml(c)}</button>`).join('')}
      </div>
      <div class="pq-nav">
        <button class="pq-btn pq-btn-ghost" id="pq-back" ${state.qIndex === 0 ? 'disabled' : ''}>Back</button>
        <button class="pq-btn" id="pq-next" ${selected === null ? 'disabled' : ''}>${state.qIndex === QUESTIONS.length - 1 ? 'Finish' : 'Next'}</button>
      </div>
    `;
    root.querySelectorAll('.pq-choice').forEach(btn => {
      btn.onclick = () => { state.answers[state.qIndex] = parseInt(btn.dataset.i, 10); render(); };
    });
    document.getElementById('pq-back').onclick = () => { if (state.qIndex > 0) { state.qIndex--; render(); } };
    document.getElementById('pq-next').onclick = () => {
      if (state.answers[state.qIndex] === null) return;
      if (state.qIndex < QUESTIONS.length - 1) { state.qIndex++; render(); }
      else { submitQuiz(); }
    };
  }

  function renderSubmitting() {
    root.innerHTML = `<p class="pq-loading">grading &amp; comparing against other participants…</p>`;
  }

  function computeScore() {
    let correct = 0;
    QUESTIONS.forEach((q, i) => { if (state.answers[i] === q.correctIndex) correct++; });
    return correct;
  }

  async function submitQuiz() {
    state.screen = 'submitting';
    render();
    const score = computeScore();
    const total = QUESTIONS.length;

    try {
      if (!GOOGLE_SHEETS_URL) throw new Error("GOOGLE_SHEETS_URL not configured");

      // Text/plain avoids a CORS preflight that Apps Script can't answer.
      await fetch(GOOGLE_SHEETS_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify({ score, total })
      });

      const attempts = await fetchAttempts();
      const scores = attempts.filter(a => a.total === total).map(a => a.score);

      const totalParticipants = scores.length || 1;
      const below = scores.filter(s => s < score).length;
      const tied = scores.filter(s => s === score).length;
      const percentile = Math.round(((below + 0.5 * tied) / totalParticipants) * 100);

      state.percentileData = { score, total, totalParticipants, percentile: Math.max(0, Math.min(100, percentile)) };
      state.screen = 'results';
    } catch (e) {
      state.percentileData = { score, total, totalParticipants: 1, percentile: null };
      state.error = "Couldn't reach shared results — showing your score only.";
      state.screen = 'results';
    }
    render();
  }

  function renderResults() {
    const d = state.percentileData;
    const pct = d.percentile;
    const pctLabel = pct === null ? "—" : pct;

    root.innerHTML = `
      <div class="pq-center">
        <div class="pq-readout">${d.score}<span>/ ${d.total} correct</span></div>
        ${pct === null
          ? `<p class="pq-percentile-line">${escapeHtml(state.error || '')}</p>`
          : `<p class="pq-percentile-line">You scored higher than<br/><strong>${pctLabel}%</strong> of participants</p>
             <p class="pq-count">based on ${d.totalParticipants} completed attempt${d.totalParticipants === 1 ? '' : 's'}</p>`
        }
        ${pct !== null ? renderGauge(pct) : ''}
        <button class="pq-btn pq-btn-ghost" id="pq-retake">Take again</button>
      </div>
      ${renderReview()}
    `;
    document.getElementById('pq-retake').onclick = () => {
      state = { screen: 'intro', qIndex: 0, answers: new Array(QUESTIONS.length).fill(null), percentileData: null, error: null };
      render();
    };
  }

  function renderGauge(pct) {
    const width = 320, height = 200;
    const cx = width / 2, cy = 170, r = 130;
    const startAngle = 180, endAngle = 0; // sweep left -> right over the top
    const angleForPct = (p) => startAngle + (endAngle - startAngle) * (p / 100);
    const toXY = (angleDeg, radius) => {
      const rad = (angleDeg * Math.PI) / 180;
      return [cx + radius * Math.cos(rad), cy - radius * Math.sin(rad)];
    };

    const [trackX1, trackY1] = toXY(startAngle, r);
    const [trackX2, trackY2] = toXY(endAngle, r);
    const trackPath = `M ${trackX1.toFixed(1)} ${trackY1.toFixed(1)} A ${r} ${r} 0 0 1 ${trackX2.toFixed(1)} ${trackY2.toFixed(1)}`;

    const valAngle = angleForPct(pct);
    const [valX, valY] = toXY(valAngle, r);
    const largeArc = pct > 50 ? 1 : 0;
    const valuePath = `M ${trackX1.toFixed(1)} ${trackY1.toFixed(1)} A ${r} ${r} 0 ${largeArc} 1 ${valX.toFixed(1)} ${valY.toFixed(1)}`;

    const needleLen = r - 22;
    const [needleX, needleY] = toXY(valAngle, needleLen);

    const ticks = [0, 25, 50, 75, 100].map(t => {
      const a = angleForPct(t);
      const [tx, ty] = toXY(a, r + 16);
      return `<text x="${tx.toFixed(1)}" y="${ty.toFixed(1)}" text-anchor="middle" class="pq-gauge-tick" font-size="10">${t}</text>`;
    }).join('');

    return `
      <div class="pq-gauge-wrap">
        <svg viewBox="0 0 ${width} ${height}" width="280" height="${height * 280 / width}" xmlns="http://www.w3.org/2000/svg" style="margin: 0 auto; display: block;">
          <path d="${trackPath}" fill="none" stroke="#ECEFEA" stroke-width="14" stroke-linecap="round"/>
          <path d="${valuePath}" fill="none" stroke="#1FA971" stroke-width="14" stroke-linecap="round"/>
          ${ticks}
          <line x1="${cx}" y1="${cy}" x2="${needleX.toFixed(1)}" y2="${needleY.toFixed(1)}" stroke="#151742" stroke-width="2.5" stroke-linecap="round"/>
          <circle cx="${cx}" cy="${cy}" r="6" fill="#151742"/>
          <text x="${cx}" y="${cy - 34}" text-anchor="middle" class="pq-gauge-value" font-size="30">${pct}%</text>
        </svg>
      </div>
    `;
  }

  function renderReview() {
    const items = QUESTIONS.map((q, qi) => {
      const userAns = state.answers[qi];
      const isCorrect = userAns === q.correctIndex;
      const choicesHtml = q.choices.map((c, ci) => {
        let cls = '';
        let tag = '';
        if (ci === q.correctIndex) { cls = 'is-correct'; tag = '<span class="pq-review-tag">&#8592; correct</span>'; }
        if (ci === userAns && !isCorrect) { cls = 'is-user-wrong'; tag = '<span class="pq-review-tag">&#8592; your answer</span>'; }
        return `<div class="pq-review-choice ${cls}">${escapeHtml(c)}${tag}</div>`;
      }).join('');
      return `
        <div class="pq-review-item ${isCorrect ? 'is-correct' : 'is-wrong'}">
          <div class="pq-review-q">
            <span class="pq-review-mark ${isCorrect ? 'correct' : 'wrong'}">${isCorrect ? '\u2713' : '\u2717'}</span>
            <span>${qi + 1}. ${escapeHtml(q.text)}</span>
          </div>
          <div class="pq-review-choices">${choicesHtml}</div>
        </div>
      `;
    }).join('');

    return `
      <div class="pq-review">
        <p class="pq-review-title">Answer review</p>
        ${items}
      </div>
    `;
  }

  function escapeHtml(str) {
    const d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
  }

  render();
})();
</script>
